# Each service has its own example; never copy one service's secrets into another.
#   apps/web/.env.example            Next.js app + payment API routes
#   services/verifier/.env.example   Python verifier worker (deferred)
#   Convex deployment variables      set with `pnpm exec convex env set NAME value`
#
# Convex deployment variables (server-side, never NEXT_PUBLIC_*):
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-4-argon
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
GEMINI_FINANCE_MODEL=gemini-3.8-flash
# Optional advisory demo threshold in integer micro-USD. Thresholds vary by year/jurisdiction; this is not tax law.
SKARL_TAX_REPORTING_THRESHOLD_MICRO_USD=600000000
# Shared secrets Convex uses to authenticate service callers; one per service.
SKARL_WORKER_SERVICE_SECRET=
SKARL_PAYMENTS_SERVICE_SECRET=
