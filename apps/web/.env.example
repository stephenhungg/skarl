# Copy to apps/web/.env.local. Testnet only: never use real funds for this demo.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_CONVEX_URL=https://keen-marmot-986.convex.cloud
CONVEX_DEPLOYMENT=

# Server-only payment route values (never NEXT_PUBLIC_*).
# Leave secrets blank for the local UI. Use https://skarl.vercel.app/api/orders
# for public demo creation/funding, or configure your own matching Convex/web
# payment service secret as an operator (see docs/deployment.md).
# Payouts are signed by the controller's browser wallet; no private key belongs here.
SKARL_PAYMENTS_SERVICE_SECRET=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
X402_FACILITATOR_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Public receiving address for buyer prepayments (address only, not a key).
SKARL_TREASURY_ADDRESS=0x8408a922ea400af33d7c2080a9edd5d3495b695f

# Separate operator revenue wallet (CDP skarl-finance-agent); never the treasury.
SKARL_EVIDENCE_PAYTO=
