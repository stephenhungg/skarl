# The scaffold does not call models, storage, Convex, or a wallet.
# Keep real values in an ignored local .env or the deployment secret store.
GEMINI_API_KEY=
SKARL_GEMINI_MODEL=gemini-3.8-flash
SKARL_ASR_MODEL=base.en
SKARL_SSCD_MODEL_PATH=
SKARL_MAX_VIDEO_SECONDS=30
# A future worker callback must be scoped to evidence reports only.
SKARL_VERIFIER_CALLBACK_URL=
SKARL_VERIFIER_CALLBACK_TOKEN=
# No wallet private key or payout credential belongs in this service.
