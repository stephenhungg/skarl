# The scaffold does not call models, storage, Convex, or a wallet.
# Keep real values in an ignored local .env or the deployment secret store.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
SKARL_ASR_MODEL=base.en
SKARL_SSCD_MODEL_PATH=
SKARL_MAX_VIDEO_SECONDS=30
# Signed pull requests to the Convex worker gateway (see docs/security.md).
# The secret is base64 and is distinct from every other service's secret.
SKARL_WORKER_GATEWAY_URL=
SKARL_WORKER_SERVICE_ID=
SKARL_WORKER_SERVICE_SECRET=
# No wallet private key or payout credential belongs in this service.
