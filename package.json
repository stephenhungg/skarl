{
  "name": "skarl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @skarl/web dev",
    "build": "pnpm --filter @skarl/web build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && pnpm --filter @skarl/web typecheck",
    "test": "node --test packages/contracts/src/*.test.ts packages/payments/src/*.test.ts packages/ledger/src/*.test.ts",
    "check:docs": "python3 scripts/check_docs.py",
    "check": "pnpm typecheck && pnpm test && pnpm test:convex && pnpm check:docs && pnpm build",
    "convex:dev": "convex dev",
    "check:convex": "CONVEX_AGENT_MODE=anonymous convex dev --once --typecheck enable",
    "seed": "convex run seed:demo",
    "test:convex": "vitest run --config test/convex.config.mts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@skarl/contracts": "workspace:*",
    "convex": "1.48.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.0.0",
    "convex-test": "0.0.65",
    "typescript": "~7.0.2",
    "vitest": "5.0.5"
  }
}
