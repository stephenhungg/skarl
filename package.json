{
  "name": "skarl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @skarl/web dev",
    "build": "pnpm --filter @skarl/web build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && pnpm --filter @skarl/web typecheck",
    "test": "node --test packages/contracts/src/*.test.ts packages/payments/src/*.test.ts packages/ledger/src/*.test.ts scripts/*.test.mjs",
    "check:docs": "python3 scripts/check_docs.py",
    "check": "pnpm typecheck && pnpm test && pnpm test:convex && pnpm test:payments && pnpm --filter @skarl/web test && pnpm eval:finance && pnpm check:docs && pnpm build",
    "convex:dev": "convex dev",
    "check:convex": "node scripts/check-convex.mjs",
    "seed": "convex run seed:demo",
    "test:convex": "vitest run --config test/convex.config.mts",
    "agent:fund": "node packages/payments/src/agent-fund.ts",
    "test:payments": "vitest run --config packages/payments/vitest.config.mts",
    "verify:sample": "node scripts/verify-sample.mjs",
    "demo:e2e": "node scripts/demo-e2e.mjs",
    "demo:preflight": "node scripts/demo-preflight.mjs",
    "scenario": "node scripts/scenario.mjs",
    "eval:clips": "node scripts/eval-clips.mjs",
    "test:eval": "node --test scripts/eval-clips.test.mjs",
    "cdp:policy:apply": "node scripts/cdp-policy-apply.ts",
    "demo:policy": "node scripts/cdp-policy-demo.ts",
    "agent:buy-evidence": "node packages/payments/src/agent-buy-evidence.ts",
    "agent:validate-evidence": "node packages/payments/src/agent-validate-evidence.ts",
    "cdp:webhooks:create": "node scripts/cdp-webhooks-create.mjs",
    "cdp:sql:witness": "node scripts/cdp-sql-witness.mjs",
    "eval:finance": "vitest run --config evals/finance-agent/vitest.config.mts",
    "eval:finance-live": "node evals/finance-agent/live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@auth/core": "0.41.1",
    "@coinbase/cdp-sdk": "1.60.0",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/workflow": "0.4.10",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "2.4.0",
    "@skarl/contracts": "workspace:*",
    "convex": "1.48.0",
    "ffmpeg-static": "5.3.0",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.0.0",
    "convex-test": "0.0.65",
    "typescript": "~7.0.2",
    "vitest": "5.0.5"
  }
}
