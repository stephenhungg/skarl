{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "CommonJS",
    "moduleResolution": "Node", "jsx": "react-jsx", "allowJs": true,
    "checkJs": false, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "strict": false
  },
  "include": ["src/**/*"]
}
